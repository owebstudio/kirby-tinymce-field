{
  "name": "clicktonext/kirby-tinymce-field",
  "description": "Integrates the powerful TinyMCE editor into Kirby 3",
  "type": "kirby-plugin",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby-3",
    "kirby3-plugin",
    "kirby-plugin",
    "kirby-tinymce",
    "tinymce"
  ],
  "authors": [
    {
      "name": "Click to Next",
      "email": "support@clicktonext.com",
      "homepage": "https://clicktonext.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "getkirby/composer-installer": "^1.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
