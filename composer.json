{
  "name": "owebstudio/kirby-tinymce-field",
  "description": "Integrates the powerful TinyMCE wysiwyg editor into Kirby.",
  "type": "kirby-plugin",
  "version": "2.0.0",
  "license": "proprietary",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-plugin",
    "kirby-tinymce",
    "wysiwyg",
    "editor",
    "tinymce"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.1",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "owebstudio/kirby-license": "^1.0"
  },
  "extra": {
    "installer-name": "kirby-tinymce-field",
    "kirby": {
      "compatible": "^4.0 || ^5.0"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
