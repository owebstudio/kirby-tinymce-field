{
  "name": "owebstudio/kirby-tinymce-field",
  "description": "Integrates the powerful TinyMCE wysiwyg editor into Kirby 3.",
  "type": "kirby-plugin",
  "version": "1.2.0",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-3",
    "kirby3-plugin",
    "kirby-plugin",
    "kirby-tinymce",
    "wysiwyg",
    "editor",
    "tinymce"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.0",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "kirby-tinymce-field"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
