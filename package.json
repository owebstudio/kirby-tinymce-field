{
  "name": "kirby-tinymce-field",
  "description": "Integrates the powerful TinyMCE wysiwyg editor into Kirby 3.",
  "version": "1.1.1",
  "main": "index.js",
  "author": "Kirby Next <contact@kirbynext.com> (https://kirbynext.com)",
  "license": "MIT",
  "scripts": {
    "dev": "npx -y kirbyup src/index.js --watch",
    "build": "npx -y kirbyup src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:kirbynext/kirby-tinymce-field.git"
  },
